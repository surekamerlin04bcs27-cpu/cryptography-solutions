from flask import Flask, render_template, request
app = Flask(__name__)
def caesar_cipher(text, shift, encrypt=True):
    shift = shift if encrypt else -shift
    result = ""
    text = text.upper().replace(" ", "")
    for char in text:
        if char.isalpha():
            result += chr((ord(char) - 65 + shift) % 26 + 65)
    return result
def get_playfair_matrix(key):
    key = key.upper().replace('J', 'I')
    matrix = []
    seen = set()
    for char in key + "ABCDEFGHIKLMNOPQRSTUVWXYZ":
        if char not in seen and char.isalpha():
            seen.add(char)
            matrix.append(char)
    return [matrix[i:i+5] for i in range(0, 25, 5)]
def playfair_cipher(text, key, encrypt=True):
    matrix = get_playfair_matrix(key)
    flat_matrix = [item for sublist in matrix for item in sublist]
    text = text.upper().replace('J', 'I').replace(" ", "")

    # Prepare pairs
    pairs = []
    i = 0
    while i < len(text):
        a = text[i]
        b = text[i+1] if i+1 < len(text) else 'X'
        if a == b:
            pairs.append((a, 'X'))
            i += 1
        else:
            pairs.append((a, b))
            i += 2
    result = ""
    for a, b in pairs:
        row1, col1 = divmod(flat_matrix.index(a), 5)
        row2, col2 = divmod(flat_matrix.index(b), 5)
        shift = 1 if encrypt else -1
        if row1 == row2:
            result += matrix[row1][(col1 + shift) % 5] + matrix[row2][(col2 + shift) % 5]
        elif col1 == col2:
            result += matrix[(row1 + shift) % 5][col1] + matrix[(row2 + shift) % 5][col2]
        else:
            result += matrix[row1][col2] + matrix[row2][col1]
    return result
@app.route('/', methods=['GET', 'POST'])
def index():
    output = "RESULT"
    if request.method == 'POST':
        cipher_type = request.form.get('cipher_type')
        mode = request.form.get('mode') # encrypt or decrypt
        msg = request.form.get('message')
        if cipher_type == 'caesar':
            shift = int(request.form.get('shift', 0))
            output = caesar_cipher(msg, shift, mode == 'encrypt')
        elif cipher_type == 'playfair':
            key = request.form.get('key', '')
            output = playfair_cipher(msg, key, mode == 'encrypt')
    return render_template('index.html', output=output)
if __name__ == '__main__':
    app.run(debug=True)
